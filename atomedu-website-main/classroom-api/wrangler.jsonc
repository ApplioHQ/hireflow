{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atom-classroom-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "https://atom-edu.org"
  },
  "durable_objects": {
    "bindings": [{ "name": "CLASSROOMS", "class_name": "ClassroomSession" }]
  },
  "exports": {
    "ClassroomSession": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
