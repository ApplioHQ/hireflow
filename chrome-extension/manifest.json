{
  "manifest_version": 3,
  "name": "Applio — Save Jobs to Your Tracker",
  "version": "1.0.0",
  "description": "Save any job posting to your Applio job tracker with one click, then tailor your resume to it.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save this job to Applio",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://hireflow-api.pritamavuthu7.workers.dev/*",
    "https://appliohq.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://appliohq.com/*"],
      "js": ["content-token.js"],
      "run_at": "document_idle"
    }
  ]
}
